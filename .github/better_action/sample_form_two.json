{
  "schema": {
    "title": "Database Maintenance & Ops",
    "description": "Trigger automated database maintenance, backups, or index rebuilds.",
    "type": "object",
    "required": ["operation_type", "cluster_region", "reason"],
    "properties": {
      "operation_type": {
        "type": "string",
        "title": "Operation Type",
        "enum": ["full_backup", "schema_migration", "reindex_tables", "vacuum_analyze"],
        "default": "full_backup"
      },
      "cluster_region": {
        "type": "string",
        "title": "Database Region",
        "enum": ["us-east-1", "us-west-2", "eu-central-1", "ap-southeast-1"],
        "default": "us-east-1"
      },
      "timeout_minutes": {
        "type": "integer",
        "title": "Timeout (Minutes)",
        "default": 30,
        "minimum": 5,
        "maximum": 180
      },
      "notify_slack": {
        "type": "boolean",
        "title": "Send Slack Notification",
        "default": true
      },
      "slack_channel": {
        "type": "string",
        "title": "Slack Channel",
        "default": "#ops-alerts"
      },
      "reason": {
        "type": "string",
        "title": "Change Reason / Jira Ticket",
        "description": "Provide Jira ticket reference (e.g. OPS-1042) or reason for maintenance"
      }
    }
  },
  "uiSchema": {
    "operation_type": {
      "ui:widget": "radio"
    },
    "reason": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 3,
        "placeholder": "e.g. Weekly scheduled backup or OPS-1042 migration"
      }
    }
  }
}
