{
  "schema": {
    "title": "Application Deployment Form",
    "description": "Configure deployment parameters, microservices, and options.",
    "type": "object",
    "required": ["environment", "release_version"],
    "properties": {
      "environment": {
        "type": "string",
        "title": "Deployment Environment",
        "enum": ["development", "staging", "production"],
        "default": "staging"
      },
      "release_version": {
        "type": "string",
        "title": "Release Version",
        "default": "v1.2.0"
      },
      "deploy_notes": {
        "type": "string",
        "title": "Release Notes",
        "description": "Changelog or release summary"
      },
      "target_services": {
        "type": "array",
        "title": "Target Microservices",
        "items": {
          "type": "string",
          "enum": ["auth-service", "billing-service", "api-gateway", "notifications-worker"]
        },
        "uniqueItems": true,
        "default": ["auth-service", "api-gateway"]
      },
      "concurrency": {
        "type": "integer",
        "title": "Concurrency Limit",
        "default": 3,
        "minimum": 1,
        "maximum": 10
      },
      "dry_run": {
        "type": "boolean",
        "title": "Dry Run Mode",
        "description": "Validate workflow parameters without executing deployment",
        "default": false
      }
    }
  },
  "uiSchema": {
    "deploy_notes": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 4,
        "placeholder": "Enter release highlights or resolved issues..."
      }
    },
    "target_services": {
      "ui:widget": "checkboxes"
    }
  }
}
