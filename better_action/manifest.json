{
  "manifest_version": 3,
  "name": "Better Action",
  "version": "1.0.0",
  "description": "Advanced GitHub Actions workflow UI in your browser sidebar with dynamic SurveyJS forms.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Better Action Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "settings/settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel/*", "icons/*", "tab/*"],
      "matches": ["https://github.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' https: http:; img-src 'self' https: data:; frame-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
  }
}
